# Copy to .env.local for local development (gitignored):
#   cp .env.example .env.local
# After `npm run infra:up`, run `npm run env:sync` to fill Supabase keys from `supabase status`.

# --- Local defaults (override for production) ---
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Skip /_next/image in dev (optional; next.config also disables it in development)
# NEXT_PUBLIC_IMAGE_UNOPTIMIZED=true
NEXT_PUBLIC_VOICE_AI_BASE_URL=http://127.0.0.1:3000

# Sentry — set NEXT_PUBLIC_APP_ENV=staging locally when testing events
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=local

# PostHog — local is opt-out by default; use staging env for ngrok testing
NEXT_PUBLIC_POSTHOG_KEY_DEV=
NEXT_PUBLIC_POSTHOG_KEY_PROD=
# PostHog Logs reuse the matching project key above in the node runtime.

# Supabase — env:sync overwrites these when using local Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# VAPID Keys for Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stripe (use test keys locally)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Resend — transactional email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx

# MoonPay Commerce — https://app.hel.io
NEXT_PUBLIC_MOONPAY_PAYLINK_ID=your_dynamic_paylink_id_here
MOONPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Onyx Payment — https://dashboard.onyxprocessing.com
ONYX_API_KEY=your_onyx_api_key_here
ONYX_MERCHANT_ID=your_onyx_merchant_id_here
ONYX_API_ENDPOINT=https://dashboard.onyxprocessing.com
ONYX_ENVIRONMENT=sandbox

# Cron: GET /api/cron/onyx-rebill with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_cron_secret_here

# Card encryption: openssl rand -hex 32
CARD_ENCRYPTION_KEY=your_64_hex_char_key_here

# Veriff — https://portal.veriff.com
VERIFF_API_KEY=your_veriff_api_key_here
VERIFF_SHARED_SECRET_KEY=your_veriff_shared_secret_key_here
