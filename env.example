# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Base URL for the application (used for business profile URLs)
NEXT_PUBLIC_VOICE_AI_BASE_URL=https://your-domain.com

# Supabase Configuration
# Get these from your Supabase Dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend — transactional email (https://resend.com)
# API key: Resend Dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxx
# Verified sender, e.g. "Blabber <noreply@yourdomain.com>" (domain must be verified in Resend)
RESEND_FROM=Blabber <noreply@blabber.ai>
# Optional: inbound address for content-removal form (defaults to support@blabber.ai)
# RESEND_CONTENT_REMOVAL_TO=support@blabber.ai
# Discord invite link sent in beta-waitlist acceptance emails. Falls back to a placeholder if unset.
# BETA_DISCORD_INVITE_URL=https://discord.gg/your-invite
#
# Supabase Auth emails: Dashboard → Project Settings → Authentication → SMTP Settings
# Enable Custom SMTP and use Resend SMTP (https://resend.com/docs/send-with-supabase-smtp):
#   Host: smtp.resend.com
#   Port: 465 (SSL) or 587 (STARTTLS)
#   Username: resend
#   Password: your RESEND_API_KEY (same as above)
#   Sender email: must exactly match a verified sender/domain in Resend (same domain as RESEND_FROM)
#
# Deliverability (junk folder is usually NOT fixed by HTML alone):
#   - In Resend: verify your domain (DNS), add SPF/DKIM records they give you; publish DMARC (e.g. p=none then tighten).
#   - In Resend: disable link tracking and open tracking for auth mail if enabled (rewritten links look suspicious).
#   - Supabase SMTP "sender" must match the verified From domain; misalignment fails DMARC and hurts inbox placement.
#   - Use Google Postmaster Tools and Microsoft SNDS for your domain once you send volume.
#
# Branded HTML for auth templates: run `npm run email:export-templates` and paste files from emails/generated/
# into Supabase → Authentication → Email templates (HTML body).
#
# Supabase → Authentication → URL Configuration → Redirect URLs: add e.g.
#   https://blabber.ai/auth/callback
#   https://blabber.ai/auth/confirm
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/confirm
# Auth emails should use the exported templates: links go to /auth/confirm?token_hash=… so sign-in works in any browser
# (PKCE-only /auth/callback?code=… fails if the user opens the email in another app or device).
# Confirmation emails reference /logo.png — shipped as public/logo.png (same as the app).
# React Email preview: set if dev server is not localhost:3000 (must serve /logo.png), e.g.
# EMAIL_PREVIEW_ORIGIN=http://localhost:3000

# MoonPay Commerce Configuration
# Get these from your MoonPay Commerce Dashboard: https://app.hel.io
NEXT_PUBLIC_MOONPAY_PAYLINK_ID=your_dynamic_paylink_id_here
MOONPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Onyx Payment Configuration (replaces Epoch for card payments)
# Get these from Onyx Processing: https://dashboard.onyxprocessing.com
ONYX_API_KEY=your_onyx_api_key_here
ONYX_MERCHANT_ID=your_onyx_merchant_id_here
ONYX_API_ENDPOINT=https://dashboard.onyxprocessing.com
# Optional: 'live' or 'sandbox'
ONYX_ENVIRONMENT=live

# GOAT Payments Configuration (alternate high-risk card processor)
# Docs: https://developers.goatpaymentsdashboard.com
# Switch to GOAT from admin → platform settings → fiat_payment_processor=goat.
#
# Auth is a Bearer token (the GOAT dashboard's "merchant token credentials"). The
# token already encodes the merchant, so no MERCHANT_ID is required — only the
# terminal id, which is supplied per-request as `terminal.id`.
GOAT_API_KEY=your_goat_bearer_token_here
GOAT_TERMINAL_ID=your_goat_terminal_id_here
# Base URL for the GOAT API. Default works for production; swap for sandbox if
# GOAT exposes a separate hostname (e.g. api.sandbox.goatpaymentsdashboard.com).
GOAT_API_ENDPOINT=https://api.goatpaymentsdashboard.com
# `level` is the card-data level (1 = basic, 2 = commercial, 3 = line items).
# Defaults to 1 — adjust if your terminal is configured for L2/L3 data.
GOAT_LEVEL=1
# `source` is documented as required but the literal value isn't enumerated. We
# default to "internet" (e-commerce); change to whatever your terminal expects.
GOAT_SOURCE=internet
# Webhook signing secret — verify "Payment Transaction Created" / "High Risk
# Authorization Warning" callbacks at /api/goat-webhook. Leave blank to skip
# signature verification (NOT recommended in production).
GOAT_WEBHOOK_SECRET=

# USPaymate Configuration (hosted checkout — alternate fiat processor)
# Switch from admin → platform settings → fiat_payment_processor=uspaymate.
# Docs: https://api.uspaymate.net — GET /v1/status to verify credentials.
USPAYMATE_CLIENT_KEY=your_uspaymate_client_key_here
USPAYMATE_SHARED_SECRET=your_uspaymate_shared_secret_here
# Optional overrides (defaults to NEXT_PUBLIC_SITE_URL for redirect/webhook URLs)
# USPAYMATE_API_BASE=https://api.uspaymate.net
# USPAYMATE_REDIRECT_BASE_URL=https://blabber.ai

# Cron: secret for rebill endpoint (subscription renewals). Call GET /api/cron/onyx-rebill with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_cron_secret_here

# Card encryption: 32-byte key (64 hex chars) for encrypting saved card numbers for rebills. Generate with: openssl rand -hex 32
CARD_ENCRYPTION_KEY=your_64_hex_char_key_here

# Veriff Identity Verification Configuration
# Get these from your Veriff Customer Portal: https://portal.veriff.com
VERIFF_API_KEY=your_veriff_api_key_here
VERIFF_SHARED_SECRET_KEY=your_veriff_shared_secret_key_here 