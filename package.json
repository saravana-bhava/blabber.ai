{
  "name": "blabber-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "email:dev": "email dev --dir ./src/emails",
    "email:export-templates": "EMAIL_EXPORT_MODE=1 tsx scripts/render-supabase-email-templates.tsx",
    "backup:setup": "scripts/setup-automated-backups.sh",
    "backup:env": "scripts/backup-env-template.sh",
    "backup:create": "scripts/backup-supabase.sh",
    "backup:restore": "scripts/restore-supabase.sh",
    "backup:verify": "scripts/verify-backup.sh",
    "backup:cleanup": "scripts/cleanup-old-backups.sh",
    "infra:up": "bash scripts/dev-up.sh",
    "infra:down": "bash scripts/dev-down.sh",
    "infra:repair": "bash scripts/infra-repair.sh",
    "infra:docker": "docker compose --profile dev up -d",
    "infra:status": "npx supabase status",
    "env:sync": "bash scripts/sync-local-env.sh",
    "db:reset": "npx supabase db reset --local",
    "db:seed:remote": "bash scripts/seed-remote.sh",
    "db:migrate": "npx supabase migration up --local",
    "db:migrate:repair": "bash scripts/repair-local-migrations.sh",
    "db:migrate:repair:remote": "bash scripts/repair-remote-migrations.sh",
    "db:migrate:list": "npx supabase migration list --local",
    "db:push": "supabase db push --linked",
    "db:status": "supabase migration list --linked",
    "setup": "npm run infra:up && npm run env:sync",
    "dev:all": "npm run infra:up && npm run dev"
  },
